# Veyra production environment.
# Copy to .env.production (never commit it), fill every REQUIRED value, then run
# `npm run db:migrate` and start the app. The server validates this file at boot and
# refuses to start with errors. GET /api/operator/readiness (operator token) checks
# every live dependency. Secrets here must come from your secret manager in real
# deployments. Values below are placeholders, not defaults.

NODE_ENV="production"

# ---------------------------------------------------------------------------
# Core (REQUIRED)
# ---------------------------------------------------------------------------
# PostgreSQL. On Vercel/Neon use the POOLED connection string here...
DATABASE_URL=""
# ...and the DIRECT (unpooled) one here: `prisma migrate deploy` cannot run over a
# transaction pooler. Outside Vercel both values are the same.
DIRECT_URL=""
# >= 32 random chars: openssl rand -hex 32
VEYRA_SESSION_SECRET=""
# >= 24 random chars: openssl rand -hex 24  (Authorization: Bearer <token>)
VEYRA_OPERATOR_TOKEN=""
# In-process background worker: flush, reconcile, resolutions, reputation,
# inventory reconciliation, settlement. Serverless (Vercel) MUST use "0" and drive the
# jobs from a scheduler instead; vercel.json runs /api/jobs/run every minute.
VEYRA_WORKER_INTERVAL_MS="15000"
# Vercel sets this itself when you add it as an env var; Vercel Cron sends it as
# `Authorization: Bearer $CRON_SECRET` to /api/jobs/run. >= 16 chars.
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Polymarket live execution (REQUIRED for live)
# ---------------------------------------------------------------------------
POLYMARKET_EXECUTION_MODE="live"
POLYMARKET_CLOB_URL="https://clob.polymarket.com"
POLYMARKET_GAMMA_URL="https://gamma-api.polymarket.com"
POLYMARKET_CHAIN_ID="137"
# Omnibus signer (EOA) private key, 0x-prefixed 32-byte hex.
POLYMARKET_PRIVATE_KEY=""
# L2 API credentials for this signer. Set all three (recommended; required for
# inventory reconciliation) or none (derived from the key on first use).
POLYMARKET_API_KEY=""
POLYMARKET_API_SECRET=""
POLYMARKET_API_PASSPHRASE=""
# 0 = EOA holds funds. 1 = POLY_PROXY, 2 = POLY_GNOSIS_SAFE, 3 = POLY_1271 deposit
# wallet: then POLYMARKET_FUNDER_ADDRESS is the wallet that holds pUSD and shares.
POLYMARKET_SIGNATURE_TYPE="0"
POLYMARKET_FUNDER_ADDRESS=""
# Dedicated Polygon RPC (Alchemy/QuickNode/etc).
POLYGON_RPC_URL=""
POLYMARKET_ORDER_SPACING_MS="50"

# ---------------------------------------------------------------------------
# Confidence engine and execution limits (safe launch values; tune later)
# ---------------------------------------------------------------------------
VEYRA_ENGINE_VERSION="v1"
VEYRA_MIN_STAKE_USD="1.00"
# Start low for launch; raise once live fills reconcile cleanly.
VEYRA_MAX_STAKE_USD="100.00"
VEYRA_KELLY_FRACTION_BPS="2500"
VEYRA_MAX_KELLY_BPS="5000"
VEYRA_MIN_EDGE_BPS="50"
VEYRA_PRICE_AGGRESSIVENESS_BPS="3500"
VEYRA_ORDER_TYPE="FAK"
VEYRA_MAX_STALE_BPS="500"
VEYRA_MAX_SLIPPAGE_BPS="300"
VEYRA_EXECUTION_MAX_SPREAD_BPS="1500"
VEYRA_EXECUTION_MAX_ATTEMPTS="3"
VEYRA_EXECUTION_MAX_SLICE_SHARES="500"
VEYRA_EXECUTION_MAX_BOOK_AGE_MS="15000"
VEYRA_VENUE_TIMEOUT_MS="10000"
VEYRA_UNKNOWN_ORDER_GRACE_MS="120000"
VEYRA_RECONCILE_LEASE_MS="60000"
# Flat fallback only when the venue reports no fee; real fees come from trades.
VEYRA_TAKER_FEE_BPS="0"

# ---------------------------------------------------------------------------
# Omnibus inventory reconciliation (read-only)
# ---------------------------------------------------------------------------
VEYRA_INVENTORY_RECON_INTERVAL_MS="900000"
VEYRA_RECON_SHARE_TOLERANCE_MICROS="10000"
VEYRA_RECON_USDC_TOLERANCE_MICROS="10000"
# pUSD balance of the funder at a known moment (6-decimal base units + ISO time).
# Set both after funding, before the first live order, to verify cash flows.
VEYRA_OMNIBUS_USDC_BASELINE_MICROS=""
VEYRA_OMNIBUS_USDC_BASELINE_AT=""

# ---------------------------------------------------------------------------
# Veyra Conviction
# ---------------------------------------------------------------------------
VEYRA_CONVICTION_VERSION="v1"
VEYRA_CONVICTION_CAPITAL_BLEND_BPS="5500"
VEYRA_CONVICTION_SNAPSHOT_INTERVAL_MS="300000"
VEYRA_CONVICTION_SNAPSHOT_MIN_DELTA_BPS="50"
VEYRA_CONVICTION_TRAIL_LENGTH="8"
VEYRA_CONVICTION_STREAM_INTERVAL_MS="5000"

# ---------------------------------------------------------------------------
# Robinhood Chain settlement references
# ---------------------------------------------------------------------------
# Launch on testnet (46630). For mainnet (4663): RH_NETWORK="mainnet",
# RH_ENABLE_MAINNET="true", RH_RPC_URL=<provider>, NEXT_PUBLIC_RH_NETWORK="mainnet".
RH_NETWORK="testnet"
RH_ENABLE_MAINNET="false"
RH_TESTNET_RPC_URL=""
RH_RPC_URL=""
# Funded settlement signer (server only). Settlement signs nothing unless enabled.
RH_SETTLEMENT_ENABLED="true"
RH_SETTLEMENT_PRIVATE_KEY=""
RH_CONFIRMATIONS="3"
RH_MAX_FEE_GWEI="5"
RH_RECEIPT_TIMEOUT_MS="120000"
RH_SETTLEMENT_MAX_ATTEMPTS="5"
# Public (browser) values; must match RH_NETWORK.
NEXT_PUBLIC_RH_NETWORK="testnet"
NEXT_PUBLIC_RH_ENABLE_MAINNET="false"

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
SOLANA_RPC_URL=""

# ---------------------------------------------------------------------------
# Daily voting (Veyra-native pools)
# ---------------------------------------------------------------------------
# One round every 24h; the top proposals become Veyra pools when it finalizes.
VEYRA_VOTING_ROUND_MS="86400000"
VEYRA_VOTING_SELECTION_COUNT="5"
# Per wallet, per round.
VEYRA_VOTING_VOTES_PER_WALLET="3"
VEYRA_VOTING_PROPOSALS_PER_WALLET="3"
VEYRA_VOTING_DEFAULT_CATEGORY="community"

# ---------------------------------------------------------------------------
# Deposit/treasury wallet (custody) - kept separate from execution
# ---------------------------------------------------------------------------
# Address ONLY. There is deliberately no treasury private key: the server cannot
# move user deposits, so the Polymarket execution path can never reach them.
# Boot fails if this equals POLYMARKET_FUNDER_ADDRESS.
VEYRA_TREASURY_ADDRESS=""
# Supported deposit assets: SYMBOL:contract:chainId:decimals, comma-separated.
# Unset means deposits are disabled (an unlisted asset is never credited).
VEYRA_TREASURY_ASSETS=""

# ---------------------------------------------------------------------------
# Veyra pool market making (liquidity fund)
# ---------------------------------------------------------------------------
# Veyra is the counterparty for Veyra-native pools, so each value below caps how
# much house capital one pool can lose. Worst case per pool is b*ln(2), reserved
# from the fund when the pool opens and released at settlement.
# 5 pools/day at 250 USDC is 1,250 USDC/day of worst-case exposure.
VEYRA_POOL_BUDGET_MICROS="250000000"
# Below this a pool opens unfunded and stays unquotable rather than thinly priced.
VEYRA_POOL_MIN_BUDGET_MICROS="25000000"
# Fee on trader profit at resolution, bps. 200 = 2% (break-even accuracy ~50.5%).
VEYRA_POOL_FEE_BPS="200"
# Operator capital that bootstraps the fund. Fees cannot seed it: at launch there
# is no trading to generate them. Add more via POST /api/operator/liquidity.
VEYRA_LIQUIDITY_FUND_SEED_MICROS="0"
# Ladder shape: shares per level, price granularity (bps), depth.
VEYRA_POOL_LOT_MICROS="1000000"
VEYRA_POOL_TICK_BPS="100"
VEYRA_POOL_MAX_LEVELS="60"

# Show the markets page's static sample sections (featured event, packs,
# leaderboards, trending, sport/esports rails). They are not backed by the API, so
# they stay hidden unless explicitly enabled.
NEXT_PUBLIC_VEYRA_SAMPLE_SECTIONS="false"

# Cash custody. OFF by default: turning this on is the deliberate act of starting to
# hold user money, and it is not finished (see TODO.md). With it off, orders never
# debit a balance. Do not enable with POLYMARKET_EXECUTION_MODE=live until custody
# is complete, or users can bet without depositing.
VEYRA_CUSTODY_ENABLED="false"
