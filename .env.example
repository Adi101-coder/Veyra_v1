# SQLite is created next to the Prisma schema.
DATABASE_URL="file:./dev.db"

# paper (default) records the Polymarket order without submitting it.
# live signs and posts via the official CLOB client using the server wallet.
POLYMARKET_EXECUTION_MODE="paper"
POLYMARKET_CLOB_URL="https://clob.polymarket.com"
POLYMARKET_CHAIN_ID="137"

# Required only for live execution. Never expose these to the browser.
POLYMARKET_PRIVATE_KEY=""
POLYMARKET_API_KEY=""
POLYMARKET_API_SECRET=""
POLYMARKET_API_PASSPHRASE=""
POLYMARKET_FUNDER_ADDRESS=""

# ConfidenceEngine knobs. All sizing math lives in src/server/confidence.
VEYRA_ENGINE_VERSION="v1"
VEYRA_KELLY_FRACTION_BPS="2500"
VEYRA_MAX_KELLY_BPS="5000"
VEYRA_MIN_EDGE_BPS="50"
VEYRA_PRICE_AGGRESSIVENESS_BPS="3500"
VEYRA_MAX_SLIPPAGE_BPS="500"
VEYRA_MAX_STALE_BPS="500"
VEYRA_MIN_STAKE_USD="1.00"
VEYRA_MAX_STAKE_USD="100000.00"
VEYRA_ORDER_TYPE="FAK"

# Smart Execution Engine. There is no Redis in this repo; SQLite + an in-process
# queue is the source of truth. Do not assume aggregation reduces venue cost.
VEYRA_EXECUTION_MAX_ATTEMPTS="3"
VEYRA_EXECUTION_MAX_SLICE_SHARES="50000"
VEYRA_EXECUTION_MAX_BOOK_AGE_MS="15000"
VEYRA_TAKER_FEE_BPS="0"

# ConvictionEngine. Headline blend is capital-weighted vs equal-weight implied P(YES).
# 5500 = 55% capital-weighted. Change this instead of editing UI or API routes.
VEYRA_CONVICTION_VERSION="v1"
VEYRA_CONVICTION_CAPITAL_BLEND_BPS="5500"
VEYRA_CONVICTION_SNAPSHOT_INTERVAL_MS="300000"
VEYRA_CONVICTION_SNAPSHOT_MIN_DELTA_BPS="50"
VEYRA_CONVICTION_TRAIL_LENGTH="8"
VEYRA_CONVICTION_STREAM_INTERVAL_MS="5000"
