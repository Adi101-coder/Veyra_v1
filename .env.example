# SQLite is created next to the Prisma schema.
# PostgreSQL (local: docker run -e POSTGRES_PASSWORD=veyra -p 5432:5432 postgres:17)
DATABASE_URL="postgresql://veyra:veyra@127.0.0.1:5432/veyra"
# Unpooled connection used by `prisma migrate deploy`. Same value outside Vercel/Neon.
DIRECT_URL="postgresql://veyra:veyra@127.0.0.1:5432/veyra"
# Throwaway DB for `npm test` only. Never point this at the app or production database.
# Each Prisma suite creates and drops its own schema inside this database.
TEST_DATABASE_URL="postgresql://veyra:veyra@127.0.0.1:5432/veyra_test"

# Apply the schema with `npm run db:migrate` (prisma migrate deploy).

# Wallet sessions: HMAC secret for the HttpOnly session cookie (>= 32 chars).
# Required in production; development falls back to a per-process random secret.
VEYRA_SESSION_SECRET=""

# Operator/worker endpoints (resolve, flush, jobs/run, batch detail) require
# `Authorization: Bearer $VEYRA_OPERATOR_TOKEN` (>= 24 chars). Unset = disabled.
VEYRA_OPERATOR_TOKEN=""

# In-process background worker (flush -> reconcile -> resolutions -> reputation).
# 0 disables it; then call POST /api/jobs/run from a scheduler instead.
VEYRA_WORKER_INTERVAL_MS="0"

# paper (default) records the Polymarket order without submitting it.
# live signs and posts via the official CLOB client using the server wallet.
POLYMARKET_EXECUTION_MODE="paper"
POLYMARKET_CLOB_URL="https://clob.polymarket.com"
POLYMARKET_CHAIN_ID="137"

# Required only for live execution. Never expose these to the browser.
POLYMARKET_PRIVATE_KEY=""
POLYMARKET_API_KEY=""
POLYMARKET_API_SECRET=""
POLYMARKET_API_PASSPHRASE=""
# 0 = EOA (live still uses the deposit wallet). 1 = POLY_PROXY, 2 = POLY_GNOSIS_SAFE.
# Type 3 = POLY_1271 deposit wallet. Types 1-2 require POLYMARKET_FUNDER_ADDRESS.
POLYMARKET_SIGNATURE_TYPE="0"
POLYMARKET_FUNDER_ADDRESS=""
# Builder keys deploy the deposit wallet via Polymarket's relayer (not a trade).
# polymarket.com → Settings → Builders
POLYMARKET_BUILDER_API_KEY=""
POLYMARKET_BUILDER_SECRET=""
POLYMARKET_BUILDER_PASSPHRASE=""
POLYGON_RPC_URL=""
POLYMARKET_GAMMA_URL="https://gamma-api.polymarket.com"
POLYMARKET_DATA_URL="https://data-api.polymarket.com"

# ConfidenceEngine knobs. All sizing math lives in src/server/confidence.
VEYRA_ENGINE_VERSION="v1"
VEYRA_KELLY_FRACTION_BPS="2500"
VEYRA_MAX_KELLY_BPS="5000"
VEYRA_MIN_EDGE_BPS="50"
VEYRA_PRICE_AGGRESSIVENESS_BPS="3500"
VEYRA_MAX_SLIPPAGE_BPS="500"
VEYRA_MAX_STALE_BPS="500"
VEYRA_MIN_STAKE_USD="1.00"
VEYRA_MAX_STAKE_USD="100000.00"
VEYRA_ORDER_TYPE="FAK"

# Smart Execution Engine. There is no Redis in this repo; SQLite + atomic DB claims
# are the source of truth. Retries only happen for venue-refused (429/503) orders.
# Polymarket charges taker fees per market (shares x rate x p x (1-p)); fills from
# /data/trades carry fee_rate_bps. This flat fallback applies only when none is reported.
VEYRA_EXECUTION_MAX_ATTEMPTS="3"
VEYRA_EXECUTION_MAX_SLICE_SHARES="50000"
VEYRA_EXECUTION_MAX_BOOK_AGE_MS="15000"
VEYRA_TAKER_FEE_BPS="0"
# Aggregated venue orders never walk more than this past the touch, and no order
# is sent into a wider spread. Venue calls slower than the timeout are "unknown"
# (reconciled, never retried). Unknown orders without an id are closed as unfilled
# only after this grace period AND when the venue shows no unattributed activity.
VEYRA_EXECUTION_MAX_SPREAD_BPS="2000"
VEYRA_VENUE_TIMEOUT_MS="10000"
VEYRA_UNKNOWN_ORDER_GRACE_MS="120000"
VEYRA_RECONCILE_LEASE_MS="60000"
POLYMARKET_ORDER_SPACING_MS="50"

# ConvictionEngine. Headline blend is capital-weighted vs equal-weight implied P(YES).
# 5500 = 55% capital-weighted. Change this instead of editing UI or API routes.
VEYRA_CONVICTION_VERSION="v1"
VEYRA_CONVICTION_CAPITAL_BLEND_BPS="5500"
VEYRA_CONVICTION_SNAPSHOT_INTERVAL_MS="300000"
VEYRA_CONVICTION_SNAPSHOT_MIN_DELTA_BPS="50"
VEYRA_CONVICTION_TRAIL_LENGTH="8"
VEYRA_CONVICTION_STREAM_INTERVAL_MS="5000"

# Robinhood Chain (docs.robinhood.com/chain/connecting). Testnet 46630 is the default;
# mainnet 4663 needs RH_NETWORK=mainnet AND RH_ENABLE_MAINNET=true AND RH_RPC_URL.
# Use a provider RPC (e.g. https://robinhood-testnet.g.alchemy.com/v2/<KEY>); the
# public rpc.*.chain.robinhood.com endpoints are rate-limited and not for production.
RH_NETWORK="testnet"
RH_ENABLE_MAINNET="false"
RH_TESTNET_RPC_URL=""
RH_RPC_URL=""
# Settlement references: after a prediction is scored, the signer sends a zero-value
# self-transaction carrying the ABI-encoded settlement summary. Server-only key; fund
# it with testnet ETH. Nothing is signed unless RH_SETTLEMENT_ENABLED=true.
RH_SETTLEMENT_ENABLED="false"
RH_SETTLEMENT_PRIVATE_KEY=""
RH_CONFIRMATIONS="1"
RH_MAX_FEE_GWEI="5"
RH_RECEIPT_TIMEOUT_MS="120000"
RH_SETTLEMENT_MAX_ATTEMPTS="5"
# Browser network for the wallet "Switch to Robinhood Chain" action (public values only).
NEXT_PUBLIC_RH_NETWORK="testnet"
NEXT_PUBLIC_RH_ENABLE_MAINNET="false"

# Omnibus inventory reconciliation (read-only; never changes balances or positions).
# Runs only in live mode with Polymarket API credentials. Report: GET/POST
# /api/operator/inventory-reconciliation with the operator token.
VEYRA_INVENTORY_RECON_INTERVAL_MS="900000"
VEYRA_RECON_SHARE_TOLERANCE_MICROS="10000"
VEYRA_RECON_USDC_TOLERANCE_MICROS="10000"
# Optional: pUSD balance (6-decimal base units) at a known time, to verify USDC flows.
VEYRA_OMNIBUS_USDC_BASELINE_MICROS=""
VEYRA_OMNIBUS_USDC_BASELINE_AT=""

# ---------------------------------------------------------------------------
# Daily voting (Veyra-native pools)
# ---------------------------------------------------------------------------
# One round every 24h; the top proposals become Veyra pools when it finalizes.
VEYRA_VOTING_ROUND_MS="86400000"
VEYRA_VOTING_SELECTION_COUNT="5"
# Per wallet, per round.
VEYRA_VOTING_VOTES_PER_WALLET="3"
VEYRA_VOTING_PROPOSALS_PER_WALLET="3"
VEYRA_VOTING_DEFAULT_CATEGORY="community"

# ---------------------------------------------------------------------------
# Deposit/treasury wallet (custody) - kept separate from execution
# ---------------------------------------------------------------------------
# Address ONLY. There is deliberately no treasury private key: the server cannot
# move user deposits, so the Polymarket execution path can never reach them.
# Boot fails if this equals POLYMARKET_FUNDER_ADDRESS.
VEYRA_TREASURY_ADDRESS=""
# Supported deposit assets: SYMBOL:contract:chainId:decimals, comma-separated.
# Unset means deposits are disabled (an unlisted asset is never credited).
VEYRA_TREASURY_ASSETS=""

# ---------------------------------------------------------------------------
# Veyra pool market making (liquidity fund)
# ---------------------------------------------------------------------------
# Veyra is the counterparty for Veyra-native pools, so each value below caps how
# much house capital one pool can lose. Worst case per pool is b*ln(2), reserved
# from the fund when the pool opens and released at settlement.
# 5 pools/day at 250 USDC is 1,250 USDC/day of worst-case exposure.
VEYRA_POOL_BUDGET_MICROS="250000000"
# Below this a pool opens unfunded and stays unquotable rather than thinly priced.
VEYRA_POOL_MIN_BUDGET_MICROS="25000000"
# Fee on trader profit at resolution, bps. 200 = 2% (break-even accuracy ~50.5%).
VEYRA_POOL_FEE_BPS="200"
# Operator capital that bootstraps the fund. Fees cannot seed it: at launch there
# is no trading to generate them. Add more via POST /api/operator/liquidity.
VEYRA_LIQUIDITY_FUND_SEED_MICROS="0"
# Ladder shape: shares per level, price granularity (bps), depth.
VEYRA_POOL_LOT_MICROS="1000000"
VEYRA_POOL_TICK_BPS="100"
VEYRA_POOL_MAX_LEVELS="60"

# Cash custody. OFF by default. Do not enable with POLYMARKET_EXECUTION_MODE=live
# until the launch gates in CUSTODY.md / TODO.md are signed off.
VEYRA_CUSTODY_ENABLED="false"
VEYRA_HOUSE_CAPITAL_MICROS=""
VEYRA_CONTROLLED_USDC_MICROS=""
VEYRA_TREASURY_USDC_MICROS=""
VEYRA_POOL_DISPUTE_WINDOW_HOURS="24"
VEYRA_DEPOSIT_CONFIRMATIONS="12"
VEYRA_RPC_URL=""

# Worst-case venue fee reserved on top of an order's notional, in bps. Polymarket's
# taker fee is shares x rate x p x (1 - p), which as a fraction of notional is
# bounded by the rate itself, so this must be >= the venue's fee rate. Reserving
# only the notional means a full fill costs more than was held and the fee is
# silently absorbed by the house.
VEYRA_FEE_RESERVE_BPS="200"
# Actual USDC Veyra controls, for the solvency check. Prefer leaving this UNSET:
# with it unset the check reads the omnibus wallet on-chain, which is the only
# source that can detect real drift. A typed-in figure makes the check
# self-confirming and is reported as a warning.
VEYRA_CONTROLLED_USDC_MICROS=""
VEYRA_TREASURY_USDC_MICROS=""
VEYRA_HOUSE_CAPITAL_MICROS="0"

# Largest block span the deposit watcher scans per tick. After an outage it catches
# up across several ticks rather than issuing one getLogs the RPC would reject. The
# watcher stores how far it has scanned per chain, so no deposit is skipped.
VEYRA_DEPOSIT_MAX_SPAN_BLOCKS="2000"

# A reservation open longer than this on an execution that never finished is
# reported by the solvency job. Never auto-released: the order may still fill, and
# freeing the money first would let the same balance be spent twice.
VEYRA_STALE_HOLD_HOURS="24"
